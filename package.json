{
  "name": "synapse-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "lint:copy": "node scripts/lint-copy.mjs",
    "audit:budget": "node scripts/budget.mjs",
    "verify": "npm run lint && npm run lint:copy && npm run test:redirect && npm run build && npm run audit:budget",
    "preview": "vite preview",
    "test:redirect": "node scripts/test-spa-redirect.mjs",
    "audit:deploy": "node scripts/check-deployment.mjs",
    "audit:deploy:local": "node scripts/check-deployment.mjs --local",
    "audit:build": "node scripts/check-deployment.mjs --local --build-only"
  },
  "dependencies": {
    "animejs": "^4.5.0",
    "d3-array": "^3.2.4",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.10.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/vite": "^4.1.18",
    "@types/d3-array": "^3.2.2",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "tailwindcss": "^4.1.18",
    "terser": "^5.44.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4"
  }
}
